# ── Browser (VITE_ prefix = bundled into the frontend) ────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Server-side only (Vercel env / local scripts — never shipped to browser) ──
# Anthropic API key for the /v1/messages proxy (recommendations + book lookup)
ANTHROPIC_API_KEY=sk-ant-...
# Gemini API key — fallback for when Anthropic credit is exhausted
GEMINI_API_KEY=AQ....
# Supabase secret key: admin endpoint + migration scripts
SUPABASE_SECRET_KEY=sb_secret_...
# Same URL without VITE_ prefix, used by Vercel functions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# ── Local tooling only (not needed on Vercel) ─────────────────────────────────
# Personal access token (supabase.com/dashboard/account/tokens) for schema SQL
SUPABASE_ACCESS_TOKEN=sbp_...
# Owner email for the one-time legacy migration (scripts/migrate-legacy.js)
OWNER_EMAIL=you@example.com
