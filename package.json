{
  "name": "audiolib-io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/csv.test.js test/ai-helpers.test.js test/importPipeline.test.js test/importBooks.test.js test/messages-core.test.js test/holds.test.js test/libbyStatus.test.js test/libbyAvailability.test.js test/metadata-core.test.js test/bookUtils.test.js test/metadata.test.js",
    "test:e2e": "node scripts/ui-test/coverage.mjs",
    "test:mobile": "node scripts/ui-test/mobile-audit.mjs",
    "test:integration": "node scripts/test-integration.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/seed-local.mjs --print",
    "db:seed": "node scripts/seed-local.mjs",
    "db:capture": "node scripts/seed-local.mjs --capture",
    "db:clone-prod": "node scripts/clone-prod-to-local.mjs",
    "deploy:quick": "node scripts/quick-deploy.mjs",
    "db:use-local": "node scripts/db-local.mjs",
    "backup": "node scripts/backup-legacy.js",
    "migrate": "node scripts/migrate-legacy.js",
    "verify-migration": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "vite": "^6.3.5"
  }
}
